#!/usr/bin/env bash
# scripts/hooks/pre-push
#
# Runs local CI checks before every push.
# Install: bash scripts/setup-hooks.sh

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

echo ""
echo "pre-push: running local checks..."

bash scripts/check.sh
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "pre-push: Check failed, push has been blocked. Please correct and try pushing again."
    exit 1
fi

echo ""
echo "pre-push: All checks passed."
exit 0
