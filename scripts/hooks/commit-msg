#!/usr/bin/env bash
# scripts/commit-msg
#
# Check if the commit message conforms to the Conventional Commits format:
#   <type>(<scope>)?: <subject>
#
# For example:
#   feat: add offline audio guide cache
#   fix(reminder): prevent duplicate reminder scheduling
#   test: add repository tests
#   docs: update README
#
# Install: bash scripts/setup-hooks.sh
# Bypass (not recommended): git commit --no-verify

set -uo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG="$(head -n1 "$COMMIT_MSG_FILE")"

# Merge / Revert are messages automatically generated by Git and do not apply Conventional Commits rules.
if [[ "$COMMIT_MSG" =~ ^(Merge|Revert)\  ]]; then
    exit 0
fi

TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
PATTERN="^(${TYPES})(\([a-zA-Z0-9_-]+\))?!?: .+"

if [[ "$COMMIT_MSG" =~ $PATTERN ]]; then
    exit 0
fi

echo ""
echo "commit-msg: commit message does not follow the Conventional Commits format"
echo ""
echo "Your message: $COMMIT_MSG"
echo ""
echo "Correct format: <type>(<scope>): <subject>"
echo ""
echo "Common types:"
echo "  feat     new feature"
echo "  fix      bug fix"
echo "  docs     documentation"
echo "  style    formatting only (no logic changes)"
echo "  refactor code refactor (not a new feature or bug fix)"
echo "  perf     performance improvement"
echo "  test     add or modify tests"
echo "  build    build system or dependency changes"
echo "  ci       CI configuration changes"
echo "  chore    chores (does not affect src or test)"
echo "  revert   revert a previous commit"
echo ""
echo "Examples:"
echo "  feat: add offline audio guide cache"
echo "  fix: prevent duplicate reminder scheduling"
echo ""
echo "To bypass this check (not recommended): git commit --no-verify"
exit 1
